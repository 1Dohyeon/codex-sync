{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.codex/hooks/save-docs.sh\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.codex/hooks/save-docs.sh\" hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
