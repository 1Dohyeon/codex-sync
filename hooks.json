{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.codex/hooks/save-docs.sh\" hook",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.codex/hooks/worklog.sh\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
